{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/production_project_manifest",
  "title": "Production Project Manifest",
  "type": "object",
  "required": ["version", "project", "production_mode", "target", "assets", "scenes", "profiles"],
  "properties": {
    "version": {"const": "1.0"},
    "project": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "domain": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "production_mode": {"enum": ["AUTO", "PHOTO", "VIDEO", "HYBRID"]},
    "target": {
      "type": "object",
      "required": ["platform", "aspect_ratio"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "aspect_ratio": {"enum": ["16:9", "9:16", "1:1", "21:9", "4:3"]}
      },
      "additionalProperties": false
    },
    "narration_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "semantic_purpose"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string"},
          "semantic_purpose": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "metadata"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["visual", "narration", "music", "logo", "captions", "other"]},
          "path": {"type": "string", "minLength": 1},
          "metadata": {
            "type": "object",
            "properties": {
              "media_type": {"type": "string"},
              "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "fps": {"type": "number", "exclusiveMinimum": 0},
              "has_audio": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "semantic_tags": {"type": "array", "items": {"type": "string"}},
          "checksum": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_scene"}
    },
    "profiles": {"$ref": "../profiles/composition_profiles.schema.json"},
    "delivery": {
      "type": "object",
      "properties": {
        "cta": {"type": "string"},
        "contacts": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "audio": {"type": "object"},
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "base_variant": {"type": "string"},
          "target_overrides": {"type": "object"},
          "profile_overrides": {"type": "object"},
          "delivery_overrides": {"type": "object"},
          "scene_overrides": {"type": "object", "additionalProperties": {"type": "object", "properties": {"motion_hint": {"$ref": "#/$defs/motion_hint"}, "transition": {"$ref": "#/$defs/scene_transition"}}, "additionalProperties": true}},
          "policy": {
            "type": "object",
            "properties": {
              "contacts": {"enum": ["preserve", "omit"]},
              "cta": {"enum": ["preserve", "omit"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "transition_input": {"enum": ["cut", "fade", "hard_cut", "crossfade", "subtle_zoom", "directional_push", "matched_motion", "section_transition"]},
    "scene_transition": {
      "type": "object",
      "properties": {
        "in": {"$ref": "#/$defs/transition_input"},
        "out": {"$ref": "#/$defs/transition_input"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "in_duration_seconds": {"type": "number", "minimum": 0},
        "out_duration_seconds": {"type": "number", "minimum": 0},
        "in_direction": {"enum": ["left", "right", "up", "down"]},
        "out_direction": {"enum": ["left", "right", "up", "down"]}
      },
      "additionalProperties": false
    },
    "motion_hint": {
      "type": "object",
      "required": ["direction"],
      "properties": {"direction": {"enum": ["left", "right", "up", "down"]}},
      "additionalProperties": false
    },
    "source_scene": {
      "type": "object",
      "required": ["id", "order", "asset_id", "timing", "match"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "asset_id": {"type": "string", "minLength": 1},
        "narration_segment_id": {"type": "string"},
        "match": {
          "type": "object",
          "required": ["method", "reason"],
          "properties": {
            "method": {"enum": ["manual", "declared"]},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "semantic_role": {"type": "string", "minLength": 1},
        "environment": {"enum": ["exterior", "interior", "unknown"]},
        "section_id": {"type": "string", "minLength": 1},
        "motion_hint": {"$ref": "#/$defs/motion_hint"},        "timing": {
          "type": "object",
          "required": ["duration_seconds"],
          "properties": {
            "duration_seconds": {"type": "number"},
            "in_seconds": {"type": "number", "minimum": 0},
            "out_seconds": {"type": "number", "minimum": 0},
            "playback_rate": {"type": "number"}
          },
          "additionalProperties": false
        },
        "visual": {
          "type": "object",
          "properties": {
            "object_position": {
              "oneOf": [
                {"type": "string"},
                {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}, "additionalProperties": false}
              ]
            },
            "crop": {
              "type": "object",
              "required": ["x", "y", "width", "height"],
              "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}},
              "additionalProperties": false
            },
            "photo_motion": {"type": "string"}
          },
          "additionalProperties": false
        },
        "transition": {"$ref": "#/$defs/scene_transition"},
        "source_audio": {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"enum": ["muted", "original"]}, "volume": {"type": "number", "minimum": 0, "maximum": 1}},
          "additionalProperties": false
        },
        "captions": {"type": "object"},
        "branding": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
