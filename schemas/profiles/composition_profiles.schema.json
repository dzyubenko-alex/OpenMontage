{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/profiles/composition_profiles",
  "title": "Composition Profiles",
  "description": "Domain-neutral creative and delivery controls for profile-driven compositions.",
  "type": "object",
  "required": ["voice", "music", "editing", "branding", "export"],
  "properties": {
    "voice": {
      "type": "object",
      "required": ["enabled", "volume", "captions"],
      "properties": {
        "enabled": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "captions": {
          "type": "object",
          "required": ["enabled", "words_per_page", "font_size"],
          "properties": {
            "enabled": { "type": "boolean" },
            "words_per_page": { "type": "integer", "minimum": 1 },
            "font_size": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "music": {
      "type": "object",
      "required": ["enabled", "volume", "fade_in_seconds", "fade_out_seconds", "loop", "ducking"],
      "properties": {
        "enabled": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "fade_in_seconds": { "type": "number", "minimum": 0 },
        "fade_out_seconds": { "type": "number", "minimum": 0 },
        "loop": { "type": "boolean" },
        "ducking": {
          "type": "object",
          "required": ["enabled", "volume_multiplier"],
          "properties": {
            "enabled": { "type": "boolean" },
            "volume_multiplier": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "editing": {
      "type": "object",
      "required": ["motion", "transition", "transition_seconds", "image_fit", "background_color", "scale_from", "scale_to", "pan_x", "pan_y"],
      "properties": {
        "motion": { "type": "string", "enum": ["static", "zoom", "pan", "alternate"] },
        "transition": { "type": "string", "enum": ["cut", "fade"] },
        "transition_seconds": { "type": "number", "minimum": 0 },
        "image_fit": { "type": "string", "enum": ["cover", "contain"] },
        "background_color": { "type": "string" },
        "scale_from": { "type": "number", "minimum": 0.1 },
        "scale_to": { "type": "number", "minimum": 0.1 },
        "pan_x": { "type": "number" },
        "pan_y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "required": ["enabled", "position", "opacity", "max_width", "safe_margin", "primary_color", "text_color", "caption_background_color", "font_family", "title_font_size", "subtitle_font_size"],
      "properties": {
        "enabled": { "type": "boolean" },
        "logo_src": { "type": "string" },
        "position": { "type": "string", "enum": ["top-left", "top-right", "bottom-left", "bottom-right"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_width": { "type": "number", "minimum": 1 },
        "safe_margin": { "type": "number", "minimum": 0 },
        "primary_color": { "type": "string" },
        "text_color": { "type": "string" },
        "caption_background_color": { "type": "string" },
        "font_family": { "type": "string" },
        "title_font_size": { "type": "number", "minimum": 1 },
        "subtitle_font_size": { "type": "number", "minimum": 1 },
        "end_card": {
          "type": "object",
          "required": ["enabled", "title", "duration_seconds"],
          "properties": {
            "enabled": { "type": "boolean" },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "duration_seconds": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "required": ["media_profile"],
      "properties": {
        "media_profile": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1, "readOnly": true },
        "height": { "type": "integer", "minimum": 1, "readOnly": true },
        "fps": { "type": "integer", "minimum": 1, "readOnly": true },
        "preview": { "$ref": "preview_export_profile.schema.json" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
