{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"openmontage/profiles/voice_generation_profile","title":"Voice Generation Profile","description":"Reusable narration voice settings with environment-backed provider identifiers.","type":"object","required":["profile_id","provider","purpose","voice_name","voice_id_env","model_id","voice_settings","volume","delivery","text_preparation"],"properties":{"profile_id":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"provider":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"voice_name":{"type":"string","minLength":1},"voice_id_env":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"model_id":{"type":"string","minLength":1},"voice_settings":{"type":"object","required":["stability","similarity_boost","style","speed","use_speaker_boost"],"properties":{"stability":{"type":"number","minimum":0,"maximum":1},"similarity_boost":{"type":"number","minimum":0,"maximum":1},"style":{"type":"number","minimum":0,"maximum":1},"speed":{"type":"number","minimum":0.7,"maximum":1.2},"use_speaker_boost":{"type":"boolean"}},"additionalProperties":false},"volume":{"type":"number","minimum":0,"maximum":1},"delivery":{"type":"object","required":["tone","avoid","pauses"],"properties":{"tone":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"avoid":{"type":"array","items":{"type":"string","minLength":1}},"pauses":{"type":"string","minLength":1}},"additionalProperties":false},"text_preparation":{"type":"object","required":["adapt_stress","adapt_numbers","adapt_for_tts"],"properties":{"adapt_stress":{"type":"boolean"},"adapt_numbers":{"type":"boolean"},"adapt_for_tts":{"type":"boolean"}},"additionalProperties":false}},"additionalProperties":false}
